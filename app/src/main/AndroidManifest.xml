<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- состояние сети: «Нет интернета» в магазине; обычное разрешение, выдаётся без запроса -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- уведомления: «магазин открылся» и другие новости (Android 13+ спрашивает разрешение) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- фоновая проверка уведомлений продолжает работать после перезагрузки телефона -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- обновление внутри приложения: загрузка в фоне с прогрессом в уведомлении и установка скачанного APK -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- скриншоты в галерею на Android 8–9; папка KAPSULA в корне памяти на Android 8–10 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- проводник и поиск игр: Android 8–10 — чтение памяти; Android 11+ — «Доступ ко всем файлам» (по желанию, игрок включает сам) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <application
        android:appCategory="game"
        android:isGame="true"
        android:requestLegacyExternalStorage="true"
        android:largeHeap="true"
        android:allowBackup="true"
        android:label="KAPSULA"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Kapsula"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Kapsula.Starting"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- подарок с сайта: kapsula://gift/КОД -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kapsula" android:host="gift" />
            </intent-filter>
        </activity>
        <!-- Экран игры: отдельный процесс, чтобы ядро libretro полностью выгружалось после выхода -->
        <activity
            android:name=".emulator.GameActivity"
            android:process=":game"
            android:theme="@style/Theme.Kapsula"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|uiMode"
            android:exported="false" />
        <!-- «Поделиться» карточкой профиля: картинка из кэша отдаётся другому приложению по временной ссылке -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>
        <service
            android:name=".data.UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".data.KapsulaFcm"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".data.InboxJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
</manifest>
